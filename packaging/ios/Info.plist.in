<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Info.plist for the iPadOS build of Krita. CMake fills the ${...} values
  from the MACOSX_BUNDLE_* target properties set in krita/CMakeLists.txt.

  Unverified: nothing has been built or signed with this file yet.
-->
<plist version="1.0">
  <dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
    <key>CFBundleIdentifier</key>
    <string>${MACOSX_BUNDLE_GUI_IDENTIFIER}</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>${MACOSX_BUNDLE_BUNDLE_NAME}</string>
    <!-- App icon: compiled from pics/branding/<branding>/krita.icon by actool
         (krita/CMakeLists.txt) into Assets.car and fallback PNGs -->
    <key>CFBundleIcons</key>
    <dict>
      <key>CFBundlePrimaryIcon</key>
      <dict>
        <key>CFBundleIconFiles</key>
        <array>
          <string>krita60x60</string>
        </array>
        <key>CFBundleIconName</key>
        <string>krita</string>
      </dict>
    </dict>
    <key>CFBundleIcons~ipad</key>
    <dict>
      <key>CFBundlePrimaryIcon</key>
      <dict>
        <key>CFBundleIconFiles</key>
        <array>
          <string>krita60x60</string>
          <string>krita76x76</string>
        </array>
        <key>CFBundleIconName</key>
        <string>krita</string>
      </dict>
    </dict>
    <key>CFBundleDisplayName</key>
    <string>${MACOSX_BUNDLE_BUNDLE_NAME}</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>${MACOSX_BUNDLE_SHORT_VERSION_STRING}</string>
    <key>CFBundleVersion</key>
    <string>${MACOSX_BUNDLE_BUNDLE_VERSION}</string>
    <key>CFBundleSignature</key>
    <string>KRTA</string>
    <key>CFBundleSupportedPlatforms</key>
    <array>
      <string>iPhoneOS</string>
    </array>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>MinimumOSVersion</key>
    <string>${KRITA_IOS_DEPLOYMENT_TARGET}</string>
    <key>NSHumanReadableCopyright</key>
    <string>${MACOSX_BUNDLE_COPYRIGHT}</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.graphics-design</string>

    <!-- iPad only -->
    <key>UIDeviceFamily</key>
    <array>
      <integer>2</integer>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
      <string>UIInterfaceOrientationLandscapeLeft</string>
      <string>UIInterfaceOrientationLandscapeRight</string>
      <string>UIInterfaceOrientationPortrait</string>
      <string>UIInterfaceOrientationPortraitUpsideDown</string>
    </array>
    <!-- No Split View / Slide Over resizing while the window is fixed to the screen size (KisMainWindow, KRITA_MOBILE) -->
    <key>UIRequiresFullScreen</key>
    <true/>
    <!-- A generated launch screen; avoids shipping a storyboard -->
    <key>UILaunchScreen</key>
    <dict/>
    <key>UIApplicationSupportsIndirectInputEvents</key>
    <true/>
    <key>UIStatusBarHidden</key>
    <true/>
    <key>UIViewControllerBasedStatusBarAppearance</key>
    <false/>

    <!-- The Documents directory (where KoResourcePaths puts the resource folder on iOS) is visible in the Files app, and documents can be opened in place -->
    <key>UIFileSharingEnabled</key>
    <true/>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>

    <key>CFBundleDocumentTypes</key>
    <array>
      <dict>
        <key>CFBundleTypeName</key>
        <string>Krita File</string>
        <key>CFBundleTypeRole</key>
        <string>Editor</string>
        <key>LSHandlerRank</key>
        <string>Owner</string>
        <key>LSItemContentTypes</key>
        <array>
          <string>org.krita.kra</string>
        </array>
      </dict>
      <dict>
        <key>CFBundleTypeName</key>
        <string>Krita Archival File</string>
        <key>CFBundleTypeRole</key>
        <string>Editor</string>
        <key>LSHandlerRank</key>
        <string>Owner</string>
        <key>LSItemContentTypes</key>
        <array>
          <string>org.krita.krz</string>
        </array>
      </dict>
      <dict>
        <key>CFBundleTypeName</key>
        <string>Krita Resource Bundle</string>
        <key>CFBundleTypeRole</key>
        <string>Viewer</string>
        <key>LSHandlerRank</key>
        <string>Owner</string>
        <key>LSItemContentTypes</key>
        <array>
          <string>org.krita.bundle</string>
        </array>
      </dict>
      <dict>
        <key>CFBundleTypeName</key>
        <string>Image</string>
        <key>CFBundleTypeRole</key>
        <string>Editor</string>
        <key>LSHandlerRank</key>
        <string>Alternate</string>
        <key>LSItemContentTypes</key>
        <array>
          <string>public.png</string>
          <string>public.jpeg</string>
          <string>public.tiff</string>
          <string>com.adobe.photoshop-image</string>
          <string>org.openraster.ora</string>
        </array>
      </dict>
    </array>

    <key>UTExportedTypeDeclarations</key>
    <array>
      <dict>
        <key>UTTypeIdentifier</key>
        <string>org.krita.kra</string>
        <key>UTTypeDescription</key>
        <string>Krita Image File</string>
        <key>UTTypeConformsTo</key>
        <array>
          <string>public.data</string>
          <string>public.image</string>
        </array>
        <key>UTTypeTagSpecification</key>
        <dict>
          <key>public.filename-extension</key>
          <array>
            <string>kra</string>
          </array>
          <key>public.mime-type</key>
          <array>
            <string>application/x-krita</string>
          </array>
        </dict>
      </dict>
      <dict>
        <key>UTTypeIdentifier</key>
        <string>org.krita.krz</string>
        <key>UTTypeDescription</key>
        <string>Krita Archival File</string>
        <key>UTTypeConformsTo</key>
        <array>
          <string>public.data</string>
          <string>public.archive</string>
          <string>public.image</string>
        </array>
        <key>UTTypeTagSpecification</key>
        <dict>
          <key>public.filename-extension</key>
          <array>
            <string>krz</string>
          </array>
          <key>public.mime-type</key>
          <array>
            <string>application/x-krita-krz</string>
          </array>
        </dict>
      </dict>
      <dict>
        <key>UTTypeIdentifier</key>
        <string>org.krita.bundle</string>
        <key>UTTypeDescription</key>
        <string>Krita Resource Bundle</string>
        <key>UTTypeConformsTo</key>
        <array>
          <string>public.data</string>
          <string>public.zip-archive</string>
        </array>
        <key>UTTypeTagSpecification</key>
        <dict>
          <key>public.filename-extension</key>
          <array>
            <string>bundle</string>
          </array>
          <key>public.mime-type</key>
          <array>
            <string>application/x-krita-bundle</string>
          </array>
        </dict>
      </dict>
      <dict>
        <key>UTTypeIdentifier</key>
        <string>org.openraster.ora</string>
        <key>UTTypeDescription</key>
        <string>OpenRaster Image</string>
        <key>UTTypeConformsTo</key>
        <array>
          <string>public.data</string>
          <string>public.image</string>
        </array>
        <key>UTTypeTagSpecification</key>
        <dict>
          <key>public.filename-extension</key>
          <array>
            <string>ora</string>
          </array>
          <key>public.mime-type</key>
          <array>
            <string>image/openraster</string>
          </array>
        </dict>
      </dict>
    </array>
  </dict>
</plist>
